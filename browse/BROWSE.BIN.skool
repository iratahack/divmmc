; Routine at 9FCC
;
; Update the full status bar. Calls L9FB8_0 with $0F (all fields: version,
; position, icons, drive).
@label=update_status_bar
c$9FCC LD A,$0F      ;
; This entry point is used by the routines at #R$8C16, #R$8C35, #R$8CD8,
; #R$8D57, #R$8E29 and #R$9E53.
*$9FCE LD IXl,A      ;
 $9FD0 AND $08       ;
 $9FD2 JR Z,$9FE8    ;
 $9FD4 LD A,($BBE5)  ;
 $9FD7 AND A         ;
 $9FD8 LD A,$20      ;
 $9FDA JR NZ,$9FDD   ;
 $9FDC XOR A         ;
*$9FDD LD ($A0C4),A  ;
 $9FE0 LD HL,$A0B5   ;
 $9FE3 LD C,$00      ;
 $9FE5 CALL $A08A    ;
*$9FE8 LD A,IXl      ;
 $9FEA AND $04       ;
 $9FEC JR Z,$A00B    ;
 $9FEE LD DE,$A0AC   ;
 $9FF1 LD HL,($BBEF) ;
 $9FF4 INC HL        ;
 $9FF5 CALL $A090    ;
 $9FF8 LD DE,$A0B0   ;
 $9FFB LD HL,($BBE9) ;
 $9FFE CALL $A090    ;
 $A001 LD HL,$A0AC   ;
 $A004 LD C,$0F      ;
 $A006 CALL $A08A    ;
 $A009 JR $A011      ;

; Routine at A00B
;
; Render the status bar fields. Updates the entry position counter (N/total),
; plugin/flag icons, and the optional 5-byte drive/speed indicator in the
; bottom status line area.
@label=render_status_fields
c$A00B LD A,IXl      ;
 $A00D AND $02       ;
 $A00F JR Z,$A032    ;
; This entry point is used by the routine at #R$9FCC.
*$A011 LD B,$04      ;
 $A013 LD C,$01      ;
 $A015 LD HL,$A0A7   ;
 $A018 LD E,$30      ;
*$A01A LD D,$2D      ;
 $A01C LD A,($BBE2)  ;
 $A01F AND C         ;
 $A020 JR Z,$A023    ;
 $A022 LD D,E        ;
*$A023 LD (HL),D     ;
 $A024 INC HL        ;
 $A025 SLA C         ;
 $A027 INC E         ;
 $A028 DJNZ $A01A    ;
 $A02A LD HL,$A0A7   ;
 $A02D LD C,$15      ;
 $A02F CALL $A08A    ;
*$A032 LD A,($A3E5)  ;
 $A035 AND $40       ;
 $A037 RET Z         ;
 $A038 LD B,$05      ;
 $A03A LD DE,$50FA   ;
*$A03D PUSH BC       ;
 $A03E LD HL,$A0C9   ;
 $A041 LD B,$08      ;
 $A043 LD C,D        ;
*$A044 LD A,(HL)     ;
 $A045 LD (DE),A     ;
 $A046 INC HL        ;
 $A047 INC D         ;
 $A048 DJNZ $A044    ;
 $A04A INC E         ;
 $A04B LD D,C        ;
 $A04C POP BC        ;
 $A04D DJNZ $A03D    ;
 $A04F LD A,($A3DF)  ;
 $A052 AND $F8       ;
 $A054 LD C,A        ;
 $A055 AND $40       ;
 $A057 JR Z,$A066    ;
 $A059 LD B,$03      ;
 $A05B LD HL,$A0D2   ;
*$A05E LD A,(HL)     ;
 $A05F OR $40        ;
 $A061 LD (HL),A     ;
 $A062 INC HL        ;
 $A063 DJNZ $A05E    ;
 $A065 LD A,C        ;
*$A066 LD HL,$A0D1   ;
 $A069 LD A,(HL)     ;
 $A06A OR C          ;
 $A06B LD (HL),A     ;
 $A06C LD A,C        ;
 $A06D AND $38       ;
 $A06F RRA           ;
 $A070 RRA           ;
 $A071 RRA           ;
 $A072 LD D,A        ;
 $A073 LD A,C        ;
 $A074 AND $C0       ;
 $A076 OR D          ;
 $A077 LD C,A        ;
 $A078 LD HL,$A0D5   ;
 $A07B LD A,(HL)     ;
 $A07C OR C          ;
 $A07D LD (HL),A     ;
 $A07E LD HL,$A0D1   ;
 $A081 LD DE,$5AFA   ;
 $A084 LD BC,$0005   ;
 $A087 LDIR          ;
 $A089 RET           ;

; Routine at A08A
;
; Render the text string at HL on the status row ($17) using L97B4.
c$A08A LD B,$17      ;
 $A08C CALL $97C3    ;
 $A08F RET           ;

; Routine at A090
;
; Convert HL to a decimal digit string at (DE). Uses repeated subtraction to
; produce up to 3 digits (hundreds, tens, units). Used for "NNN/NNN" position
; display.
c$A090 LD BC,$FF9C   ;
 $A093 CALL $A09C    ;
 $A096 LD C,$F6      ;
 $A098 CALL $A09C    ;
 $A09B LD C,B        ;
*$A09C LD A,$2F      ;
*$A09E INC A         ;
 $A09F ADD HL,BC     ;
 $A0A0 JR C,$A09E    ;
 $A0A2 SBC HL,BC     ;
 $A0A4 LD (DE),A     ;
 $A0A5 INC DE        ;
 $A0A6 RET           ;

; Message at A0A7
;
; Status bar spacer "    " (4 spaces) — blank field template.
t$A0A7 DEFM "    "

; Data block at A0AB
;
; NUL terminator byte.
b$A0AB DEFB $00

; Message at A0AC
;
; Position field work string "000/" (overwritten in-place with the current
; entry number).
t$A0AC DEFM "000/"

; Message at A0B0
;
; Position field work string "000" (overwritten with the total entry count).
t$A0B0 DEFM "000"

; Data block at A0B3
;
; Status bar display control flags ($81 = show version string + position
; counter).
b$A0B3 DEFB $81,$00

; Message at A0B5
;
; Version string ".browse v1.02a2" — shown in the status bar when $BBE5 is
; clear.
t$A0B5 DEFM ".browse v1.02a2"

; Data block at A0C4
;
; NMI status byte: $20 = NMI active (shown as 'N' in status bar), $00 =
; inactive (shown as space).
b$A0C4 DEFB $20

; Message at A0C5
;
; NMI indicator string "NMI".
t$A0C5 DEFM "NMI"

; Data block at A0C8
;
; NUL terminator for L$A0B1.
b$A0C8 DEFB $00

; Data block at A0C9
;
; Proportional font pixel-width step table (7 bytes: 1, 3, 7, 15, 31, 63, 127).
; Used by the string-width accumulator in L97B4.
b$A0C9 DEFB $01,$03,$07,$0F,$1F,$3F,$7F

; Data block at A0D0
;
; $FF end-of-width-step-table marker.
b$A0D0 DEFB $FF

; Data block at A0D1
;
; Status bar attribute byte for the position-counter field.
b$A0D1 DEFB $02

; Data block at A0D2
;
; Status bar attribute bytes for the flag icon area (3 bytes:
; flash/bright/colour for P, X, N icons).
b$A0D2 DEFB $16,$34,$25

; Data block at A0D5
;
; Status bar attribute byte for the drive/mode indicator field.
b$A0D5 DEFB $28

; Routine at A0D6
;
; JP (HL) trampoline. Jumps to the address held in HL — used to call variable
; dispatch targets without an indirect CALL instruction.
c$A0D6 JP (HL)       ;

; Routine at A0D7
;
; Busy-wait loop. Enables interrupts, executes B HALT instructions (each ~20 ms
; at 50 Hz), then disables interrupts. Used for brief timed pauses.
;
; B Number of 50 Hz frames to wait
@label=wait_frames
c$A0D7 EI            ;
*$A0D8 HALT          ;
 $A0D9 DJNZ $A0D8    ;
 $A0DB DI            ;
 $A0DC RET           ;

; Routine at A0DD
;
; Wait for any key to be pressed. Polls port $FE until all keys are released
; ($1F), then loops on HALT until a key is detected.
@label=wait_any_key
c$A0DD XOR A         ;
 $A0DE IN A,($FE)    ;
 $A0E0 AND $1F       ;
 $A0E2 CP $1F        ;
 $A0E4 JR NZ,$A0DD   ;
 $A0E6 EI            ;
*$A0E7 HALT          ;
 $A0E8 XOR A         ;
 $A0E9 IN A,($FE)    ;
 $A0EB CPL           ;
 $A0EC AND $1F       ;
 $A0EE JR NZ,$A0F2   ;
 $A0F0 DJNZ $A0E7    ;
*$A0F2 DI            ;
 $A0F3 RET           ;

; Routine at A0F4
;
; Advance DE to the NUL terminator of a string. Returns DE pointing to the $00
; byte.
;
;        DE Pointer to NUL-terminated string
; Output: DE Pointer to the NUL byte
@label=strend
c$A0F4 LD A,(DE)     ;
 $A0F5 OR A          ;
 $A0F6 JR Z,$A0FB    ;
 $A0F8 INC DE        ;
 $A0F9 JR $A0F4      ;

; Routine at A0FB
;
; Append the NUL-terminated string at HL onto the end of the string at DE (DE
; points to the NUL from L$A0E0). Copies characters until NUL, writing count to
; C.
;
;        HL Source string pointer
;        DE Pointer to destination NUL (end of existing string)
; Output: C Number of characters copied
@label=strappend
c$A0FB LD C,$00      ;
*$A0FD LD A,(HL)     ;
 $A0FE LD (DE),A     ;
 $A0FF AND A         ;
 $A100 RET Z         ;
 $A101 INC C         ;
 $A102 INC HL        ;
 $A103 INC DE        ;
 $A104 JR $A0FD      ;

; Routine at A106
;
; No-op return stub.
c$A106 RET           ;

; Routine at A107
;
; Find the first occurrence of NUL-terminated pattern HL inside NUL-terminated
; string DE. Returns DE pointing to the match start, or Fc=1 if not found.
;
;        HL Search pattern (NUL-terminated)
;        DE String to search in (NUL-terminated)
; Output: DE Pointer to match start; Fc=1 if not found
@label=strstr
c$A107 LD A,(HL)     ;
 $A108 OR A          ;
 $A109 JR Z,$A131    ;
; This entry point is used by the routine at #R$A119.
*$A10B LD A,(DE)     ;
 $A10C CP (HL)       ;
 $A10D JR Z,$A119    ;
 $A10F INC DE        ;
 $A110 OR A          ;
 $A111 JR NZ,$A10B   ;
; This entry point is used by the routine at #R$A119.
*$A113 EX DE,HL      ;
 $A114 LD HL,$0000   ;
 $A117 SCF           ;
 $A118 RET           ;

; Routine at A119
;
; Verify that a full match of the pattern occurs at the current DE position.
; Calls back to LA0F3_0 on mismatch to continue scanning.
c$A119 PUSH DE       ;
 $A11A PUSH HL       ;
 $A11B EX DE,HL      ;
*$A11C INC DE        ;
 $A11D INC HL        ;
 $A11E LD A,(DE)     ;
 $A11F OR A          ;
 $A120 JR Z,$A12E    ;
 $A122 CP (HL)       ;
 $A123 JR Z,$A11C    ;
 $A125 LD A,(HL)     ;
 $A126 POP HL        ;
 $A127 POP DE        ;
 $A128 INC DE        ;
 $A129 OR A          ;
 $A12A JR NZ,$A10B   ;
 $A12C JR $A113      ;

; Routine at A12E
;
; Pop saved registers and return — match successfully confirmed. Tail of
; L$A105.
c$A12E POP DE        ;
 $A12F POP HL        ;
 $A130 RET           ;

; Routine at A131
;
; Swap DE and HL and return. Used when the search pattern is empty (matches
; start of string).
c$A131 EX DE,HL      ;
 $A132 RET           ;

; Routine at A133
;
; Detect UNO/NextZXOS hardware. Outputs $FF to port $FC3B, reads $FD3B and
; counts valid ASCII responses. If 2 or more valid bytes are seen, sets LA1B1=1
; (device present) and stores the firmware version in LA1B2.
@label=detect_uno
c$A133 XOR A         ;
 $A134 LD ($A1C5),A  ;
 $A137 LD ($A1C6),A  ;
 $A13A LD BC,$FC3B   ;
 $A13D LD A,$FF      ;
 $A13F OUT (C),A     ;
 $A141 LD L,$00      ;
*$A143 LD BC,$FD3B   ;
 $A146 IN A,(C)      ;
 $A148 AND A         ;
 $A149 JR Z,$A156    ;
 $A14B CP $20        ;
 $A14D JR C,$A156    ;
 $A14F CP $80        ;
 $A151 JR NC,$A156   ;
 $A153 INC L         ;
 $A154 JR $A143      ;

; Routine at A156
;
; Confirm UNO/Next presence. Stores LA1B1=1 and reads the device version byte
; into LA1B2. Called after LA11F counts enough valid responses.
c$A156 LD A,L        ;
 $A157 CP $02        ;
 $A159 RET C         ;
 $A15A LD A,$01      ;
 $A15C LD ($A1C5),A  ;
 $A15F LD BC,$FC3B   ;
 $A162 LD A,$40      ;
 $A164 OUT (C),A     ;
 $A166 XOR A         ;
 $A167 LD BC,$FD3B   ;
 $A16A IN A,(C)      ;
 $A16C LD ($A1C6),A  ;
 $A16F AND A         ;
 $A170 RET Z         ;
 $A171 LD BC,$FC3B   ;
 $A174 LD A,$40      ;
 $A176 OUT (C),A     ;
 $A178 XOR A         ;
 $A179 LD BC,$FD3B   ;
 $A17C OUT (C),A     ;
 $A17E RET           ;

; Routine at A17F
;
; Send pending UNO/Next command. If LA1B1 (device present) and LA1B2 (command
; byte) are both non-zero, outputs the command to port $FD3B.
c$A17F LD A,($A1C5)  ;
 $A182 AND A         ;
 $A183 RET Z         ;
 $A184 LD A,($A1C6)  ;
 $A187 AND A         ;
 $A188 RET Z         ;
 $A189 LD D,A        ;
 $A18A LD BC,$FC3B   ;
 $A18D LD A,$40      ;
 $A18F OUT (C),A     ;
 $A191 LD A,D        ;
 $A192 LD BC,$FD3B   ;
 $A195 OUT (C),A     ;
 $A197 RET           ;

; Routine at A198
;
; Switch DivMMC/UNO memory bank. If LA1B1 is zero (no device), returns
; immediately. If L=0, outputs $0B to port $FC3B and the saved bank byte from
; LA1B3 to $FD3B. If L non-zero, saves current bank state from $FD3B to LA1B3,
; then outputs $0B+$C0 to switch.
;
; L 0 = restore saved bank; non-zero = save current bank and switch
@label=uno_bank_out
c$A198 LD A,($A1C5)  ;
 $A19B AND A         ;
 $A19C RET Z         ;
 $A19D LD BC,$FC3B   ;
 $A1A0 LD A,L        ;
 $A1A1 AND A         ;
 $A1A2 JR NZ,$A1B1   ;
 $A1A4 LD A,$0B      ;
 $A1A6 OUT (C),A     ;
 $A1A8 LD A,($A1C7)  ;
 $A1AB LD BC,$FD3B   ;
 $A1AE OUT (C),A     ;
 $A1B0 RET           ;

; Routine at A1B1
;
; Save current UNO bank state: reads port $FD3B, stores in LA1B3, then switches
; to the new bank.
c$A1B1 LD A,$0B      ;
 $A1B3 OUT (C),A     ;
 $A1B5 LD BC,$FD3B   ;
 $A1B8 IN A,(C)      ;
 $A1BA LD ($A1C7),A  ;
 $A1BD OR $C0        ;
 $A1BF LD BC,$FD3B   ;
 $A1C2 OUT (C),A     ;
 $A1C4 RET           ;

; Data block at A1C5
;
; UNO/Next device-present flag: 0 = not detected, 1 = device present.
b$A1C5 DEFB $00

; Data block at A1C6
;
; UNO/Next firmware version byte (read during detection).
b$A1C6 DEFB $00

; Data block at A1C7
;
; Saved UNO/Next bank register value (used by L$A184 to save/restore bank
; context).
b$A1C7 DEFB $00

; Routine at A1C8
;
; Write a DivMMC bank register pair. Outputs D to port $BF3B and E to port
; $FF3B.
;
; D High bank register value
; E Low bank register value
c$A1C8 LD BC,$BF3B   ;
 $A1CB OUT (C),D     ;
 $A1CD NOP           ;
 $A1CE LD BC,$FF3B   ;
 $A1D1 OUT (C),E     ;
 $A1D3 RET           ;

; Routine at A1D4
;
; Restore DivMMC bank registers to the values saved at LA1E6. Called on return
; from plugin. If LA1E6 is zero, returns immediately.
c$A1D4 LD A,($A1FA)  ;
 $A1D7 AND A         ;
 $A1D8 RET Z         ;
 $A1D9 LD DE,$4001   ;
 $A1DC CALL $A1C8    ;
 $A1DF RET           ;

; Routine at A1E0
;
; Save current DivMMC bank registers from port $FF3B into LA1E6. Reads the port
; and stores; if non-zero, switches to bank $4000.
c$A1E0 LD BC,$BF3B   ;
 $A1E3 LD A,$40      ;
 $A1E5 OUT (C),A     ;
 $A1E7 NOP           ;
 $A1E8 LD BC,$FF3B   ;
 $A1EB IN A,(C)      ;
 $A1ED LD ($A1FA),A  ;
 $A1F0 AND A         ;
 $A1F1 RET Z         ;
 $A1F2 LD DE,$4000   ;
 $A1F5 CALL $A1C8    ;
 $A1F8 RET           ;

; Routine at A1F9
;
; No-op return stub.
c$A1F9 RET           ;

; Data block at A1FA
;
; Saved DivMMC bank register value from before plugin call (restored by LA1C0).
b$A1FA DEFB $00

; Message at A1FB
;
; Error string "Err" — shown in the status bar when a plugin returns an error.
t$A1FB DEFM "Err"

; Routine at A1FE
;
; Self-modifying entry: bytes overwritten at runtime with LD L,A / LD (HL),D.
c$A1FE LD L,A        ;
 $A1FF LD (HL),D     ;

; Data block at A200
;
; Self-modifying 2-byte parameter: LD HL,n operand.
b$A200 DEFB $21,$00

; Data block at A202
;
; Plugin invocation mode byte ($50).
b$A202 DEFB $50

; Routine at A203
;
; Self-modifying entry: bytes overwritten at runtime with LD L,H / LD (HL),L /
; LD H,A / LD L,C / LD L,(HL).
c$A203 LD L,H        ;
 $A204 LD (HL),L     ;
 $A205 LD H,A        ;
 $A206 LD L,C        ;
 $A207 LD L,(HL)     ;

; Data block at A208
;
; Self-modifying 2-byte parameter used by the plugin invocation stubs.
b$A208 DEFB $3A,$00

; Routine at A20A
;
; Invoke an external plugin identified by a 3-character extension string in HL.
; Prepends '_' to the extension in LA365, appends the path "/bin/bplugins/",
; loads and runs the plugin binary from $8000 via L$A22A.
;
; HL Pointer to 3-character plugin extension string (e.g. "TXT", "HEX")
@label=invoke_plugin
c$A20A LD A,$5F      ;
 $A20C LD DE,$A379   ;
 $A20F PUSH DE       ;
 $A210 LD (DE),A     ;
 $A211 INC DE        ;
 $A212 LD BC,$0003   ;
 $A215 LDIR          ;
 $A217 POP HL        ;
 $A218 CALL $A222    ;
 $A21B LD HL,$A36B   ;
 $A21E CALL $A23E    ;
 $A221 RET           ;

; Routine at A222
;
; Build the full config-plugin path. Appends the 4-byte extension from LA37C to
; the path at LA365, then appends ".cfg" from L8723.
c$A222 LD DE,$A390   ;
 $A225 XOR A         ;
 $A226 LD (DE),A     ;
 $A227 PUSH DE       ;
 $A228 CALL $A0F4    ;
 $A22B POP DE        ;
 $A22C LD HL,$8723   ;
 $A22F CALL $A0F4    ;
 $A232 RET           ;

; Routine at A233
;
; Clear the 8-byte scroll-indicator buffer at $50F8–$50FF.
c$A233 LD DE,$50F8   ;
 $A236 LD B,$08      ;
 $A238 XOR A         ;
*$A239 LD (DE),A     ;
 $A23A INC D         ;
 $A23B DJNZ $A239    ;
 $A23D RET           ;

; Routine at A23E
;
; Load and execute the plugin binary. Banks in DivMMC page at $8C (port $E3),
; copies the current $8000 code to $2000 (save), loads the plugin from
; "/bin/bplugins/" + extension via L93CB, then calls $8000 with filename,
; config, and mode parameters. On return, restores $8000, re-banks, and
; processes the plugin return flags in LA3AF.
@label=load_and_run_plugin
c$A23E XOR A         ;
 $A23F LD ($A3C3),A  ;
 $A242 LD A,($5B5C)  ;
 $A245 AND A         ;
 $A246 JR NZ,$A24A   ;
 $A248 LD A,$10      ;
*$A24A LD ($A3C7),A  ;
 $A24D LD A,($BBE5)  ;
 $A250 LD ($A3C8),A  ;
 $A253 AND A         ;
 $A254 LD A,$02      ;
 $A256 JR Z,$A266    ;
 $A258 PUSH HL       ;
 $A259 LD HL,($BBF1) ;
 $A25C LD BC,$001E   ;
 $A25F ADD HL,BC     ;
 $A260 LD A,(HL)     ;
 $A261 LD ($A3C7),A  ;
 $A264 POP HL        ;
 $A265 XOR A         ;
*$A266 LD ($A27D),A  ;
 $A269 LD ($A2EB),A  ;
 $A26C PUSH HL       ;
 $A26D LD A,$8C      ;
 $A26F OUT ($E3),A   ;
 $A271 LD HL,$8000   ;
 $A274 LD DE,$2000   ;
 $A277 LD BC,$2000   ;
 $A27A LDIR          ;

; Data block at A27C
;
; Self-modify byte ($3E = LD A,n opcode) for bank-switch sequence in L$A22A.
b$A27C DEFB $3E

; Data block at A27D
;
; Self-modifying DivMMC bank page number loaded before calling the plugin at
; $8000.
b$A27D DEFB $00

; Routine at A27E
;
; Execute the loaded plugin at $8000. Switches in the plugin page, opens the
; config file (LA36A), calls $8000 with filename/config/mode args, then
; restores the original page and processes the return code in LA3AF.
@label=call_plugin
c$A27E ADD A,$80     ;
 $A280 OUT ($E3),A   ;
 $A282 POP HL        ;
 $A283 LD DE,$8000   ;
 $A286 LD BC,$0000   ;
 $A289 CALL $93DA    ;
 $A28C XOR A         ;
 $A28D OR L          ;
 $A28E JR Z,$A2C2    ;
 $A290 LD A,($8006)  ;
 $A293 LD E,A        ;
 $A294 AND $01       ;
 $A296 JR Z,$A2A3    ;
 $A298 LD HL,$A3DE   ;
 $A29B LD DE,$8008   ;
 $A29E LD BC,$000E   ;
 $A2A1 LDIR          ;
*$A2A3 LD HL,$A37E   ;
 $A2A6 LD DE,$A3CE   ;
 $A2A9 LD BC,$0000   ;
 $A2AC CALL $93DA    ;
 $A2AF LD DE,$A3CE   ;
 $A2B2 LD A,H        ;
 $A2B3 OR L          ;
 $A2B4 JR NZ,$A2B9   ;
 $A2B6 LD DE,$0000   ;
*$A2B9 LD HL,$BBF3   ;
 $A2BC LD BC,$A3C7   ;
 $A2BF CALL $8000    ;
*$A2C2 LD ($A3C3),A  ;
 $A2C5 LD ($A3C4),BC ;
 $A2C9 AND $D0       ;
 $A2CB JR Z,$A2DB    ;
 $A2CD LD A,B        ;
 $A2CE OR C          ;
 $A2CF JR Z,$A2DB    ;
 $A2D1 LD H,B        ;
 $A2D2 LD L,C        ;
 $A2D3 LD DE,$A399   ;
 $A2D6 LD BC,$002A   ;
 $A2D9 LDIR          ;
*$A2DB LD A,$8C      ;
 $A2DD OUT ($E3),A   ;
 $A2DF LD HL,$2000   ;
 $A2E2 LD DE,$8000   ;
 $A2E5 LD BC,$2000   ;
 $A2E8 LDIR          ;

; Data block at A2EA
;
; Self-modify byte ($3E = LD A,n opcode) for bank restore sequence.
b$A2EA DEFB $3E

; Data block at A2EB
;
; Self-modifying DivMMC page number for restoring after plugin call.
b$A2EB DEFB $00

; Routine at A2EC
;
; Process plugin return. Checks LA3AF flags: $80 = show error string; $10 =
; show info string (from LA385); $04 = reload directory; $02 and not $08 and
; LA3B2=0 = call LA344 (full display reinit).
@label=plugin_return
c$A2EC ADD A,$80     ;
 $A2EE OUT ($E3),A   ;
 $A2F0 LD A,($A3C3)  ;
 $A2F3 AND $80       ;
 $A2F5 JR Z,$A312    ;
 $A2F7 LD HL,$A1FB   ;
 $A2FA CALL $8C60    ;
 $A2FD LD HL,$A399   ;
 $A300 LD BC,$1600   ;
 $A303 CALL $97C3    ;
 $A306 CALL $9CDE    ;
 $A309 CALL $9B86    ;
 $A30C CALL $9CDE    ;
 $A30F CALL $A352    ;
*$A312 LD A,($A3C3)  ;
 $A315 AND $10       ;
 $A317 JR Z,$A330    ;
 $A319 LD HL,$A202   ;
 $A31C CALL $8C60    ;
 $A31F LD HL,$A399   ;
 $A322 LD BC,$1600   ;
 $A325 CALL $97C3    ;
 $A328 LD B,$60      ;
 $A32A CALL $A0DD    ;
 $A32D CALL $A352    ;
*$A330 LD A,($A3C3)  ;
 $A333 AND $04       ;
 $A335 JR Z,$A33A    ;
 $A337 CALL $A365    ;
*$A33A LD A,($A3C3)  ;
 $A33D AND $02       ;
 $A33F JR Z,$A351    ;
 $A341 LD A,($A3C3)  ;
 $A344 AND $08       ;
 $A346 JR NZ,$A351   ;
 $A348 LD A,($A3C6)  ;
 $A34B AND A         ;
 $A34C JR NZ,$A351   ;
 $A34E CALL $A358    ;
*$A351 RET           ;

; Routine at A352
;
; Reload directory (L=0 flag to L8C80). Called after plugin modifies the
; directory.
c$A352 LD L,$00      ;
 $A354 CALL $8C85    ;
 $A357 RET           ;

; Routine at A358
;
; Reinitialise the full display. Calls L9DA6 (clear screen + colours), L8595
; with flags=$09 (full reload), and clears LA3B2 (needs-reload flag).
c$A358 CALL $9DB5    ;
 $A35B LD A,$09      ;
 $A35D CALL $8595    ;
 $A360 XOR A         ;
 $A361 LD ($A3C6),A  ;
 $A364 RET           ;

; Routine at A365
;
; Partial directory reload. Calls L8595 with flags=$0A.
c$A365 LD A,$0A      ;
 $A367 CALL $8595    ;
 $A36A RET           ;

; Message at A36B
;
; Plugin base path "/bin/bplugins/" — prefix used when loading plugin binaries.
t$A36B DEFM "/bin/bplugins/"

; Message at A379
;
; Plugin extension work buffer "????" — overwritten in-place with '_' + 3-char
; extension by L$A1F6.
t$A379 DEFM "????"

; Data block at A37D
;
; NUL terminator for L$A365.
b$A37D DEFB $00

; Message at A37E
;
; Plugin config path "/bin/bplugins/cfg/" — used to load per-extension config
; files.
t$A37E DEFM "/bin/bplugins/cfg/"

; Data block at A390
;
; Full plugin config path buffer (9 bytes). Built by LA20E: L$A36A + extension
; + ".cfg" + NUL.
b$A390 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A398 DEFB $00

; Data block at A399
;
; Plugin message / info string buffer (42 bytes). Filled by the plugin at $8000
; when it returns flag $10 or $D0 in LA3AF.
b$A399 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A3A1 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A3A9 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A3B1 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A3B9 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A3C1 DEFB $00,$00

; Data block at A3C3
;
; Plugin return code byte. Written by the plugin at $8000 on return: $01 =
; files changed (reload); $02 = update display; $04 = reload dir; $08 = quiet;
; $10 = show info string; $40 = cursor moved; $80 = error string; $D0 = show
; result.
b$A3C3 DEFB $00

; Data block at A3C4
;
; Plugin cursor-mode byte (lo = cursor advance code, hi = plugin-type).
b$A3C4 DEFB $00,$00

; Data block at A3C6
;
; Directory-needs-reload flag. Set by plugin return; cleared by LA344.
b$A3C6 DEFB $00

; Data block at A3C7
;
; DivMMC memory bank page number for the plugin.
b$A3C7 DEFB $00

; Data block at A3C8
;
; Cartridge/ROM mode byte at the time of the plugin call.
b$A3C8 DEFB $00

; Data block at A3C9
;
; Plugin mode parameter (set by the dispatcher before calling LA1F6).
b$A3C9 DEFB $00

; Data block at A3CA
;
; Plugin parameter block pointer (4 bytes). Usually the address of the current
; 18-byte directory entry.
b$A3CA DEFB $00,$00,$00,$00

; Data block at A3CE
;
; Plugin config data buffer (16 bytes). Loaded from
; "/bin/bplugins/cfg/<ext>.cfg" before calling the plugin.
b$A3CE DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A3D6 DEFB $00,$00,$00,$00,$00,$00,$00,$00

; Data block at A3DE
;
; Header row background attribute byte (default $78 = white on black).
b$A3DE DEFB $78

; Data block at A3DF
;
; Status bar background attribute byte (default $47 = white on blue).
b$A3DF DEFB $47

; Data block at A3E0
;
; Border colour index (default $07 = white).
b$A3E0 DEFB $07

; Data block at A3E1
;
; Normal directory entry text attribute (default $38 = black on white).
b$A3E1 DEFB $38

; Data block at A3E2
;
; Directory/folder entry highlight attribute (default $39 = blue on white).
b$A3E2 DEFB $39

; Data block at A3E3
;
; Selected/cursor row attribute (default $68 = black on green).
b$A3E3 DEFB $68

; Data block at A3E4
;
; Current drive letter / colour theme index. Updated by L9535 (opendir) and
; L8F8E (colour scheme).
b$A3E4 DEFB $01

; Data block at A3E5
;
; Feature flags byte 0: bit 6=$40 = proportional font enabled; bit 5=$20 =
; cache enabled; bit 4=$10 = bookmark persistence enabled; bit 1=$02 =
; joystick/Kempston enabled; bit 0=$01 = show "<DIR" markers. Byte 1: extended
; flags.
b$A3E5 DEFB $40,$00

; Data block at A3E7
;
; Special key remapping table (5 bytes). Cursor keys and Enter: $0B=cursor-up,
; $0A=cursor-down, $08=cursor-left, $09=cursor-right, $0D=Enter. Matched by
; L9CCF via CPIR and remapped to L8EB2 action codes.
b$A3E7 DEFB $0B,$0A,$08,$09,$0D

; Data block at A3EC
;
; Last esxDOS error code from a failed file operation. Stored by L93CB/L93E2;
; cleared by L94AC.
b$A3EC DEFB $00

