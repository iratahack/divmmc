@start
@org
; Routine at 84D0
;
; Main entry point. Saves the caller's SP via self-modifying code at L84E9. If
; $BBE5 is non-zero the stack is reset to $7FFF (DivMMC cartridge mode). Calls
; init (L9DDB) then the main event loop (L9DC8).
@label=main
c$84D0 LD ($84E9),SP ;
 $84D4 LD A,($BBE5)  ;
 $84D7 OR A          ;
 $84D8 JR Z,$84DD    ;
 $84DA LD SP,$7FFF   ;
*$84DD PUSH IY       ;
 $84DF CALL $9DEA    ;
 $84E2 OR A          ;
 $84E3 CALL Z,$9DD7  ;
 $84E6 POP IY        ;

; Data block at 84E8
;
; LD SP operand byte. Self-modified by L84D0 to save the original SP value on
; entry.
b$84E8 DEFB $31

; Data block at 84E9
;
; Saved stack pointer written by the LD (L84E9),SP at L84D0.
b$84E9 DEFB $00,$00

; Routine at 84EB
;
; Stub return — placeholder or unused entry point.
c$84EB RET           ;

; Routine at 84EC
;
; Calculate the address of directory entry N in the $C200 buffer. Computes HL =
; (N*18) + $C200 and stores the result in $BF62. Each 18-byte entry contains: 1
; flag byte + 11 filename chars + 2 size bytes + 2 start-cluster bytes + 2
; attribute bytes.
;
;        HL Entry index N (0-based); treated as 0 when HL = 0
; Output: HL Pointer to entry; $BF62 also updated
@label=get_entry_ptr
c$84EC LD A,H        ;
 $84ED OR L          ;
 $84EE JR Z,$84F7    ;
 $84F0 ADD HL,HL     ;
 $84F1 LD B,H        ;
 $84F2 LD C,L        ;
 $84F3 ADD HL,HL     ;
 $84F4 ADD HL,HL     ;
 $84F5 ADD HL,HL     ;
 $84F6 ADD HL,BC     ;
*$84F7 LD BC,$C200   ;
 $84FA ADD HL,BC     ;
 $84FB LD ($BF62),HL ;
 $84FE RET           ;

; Routine at 84FF
;
; Fetch the display filename for the currently selected entry. Reads the entry
; index from $BBEF, calls L84EC to compute the entry address, then L8526 to
; format the 8.3 name into $BBF3.
@label=get_current_name
c$84FF LD HL,($BBEF) ;
 $8502 CALL $84EC    ;
 $8505 INC HL        ;
 $8506 CALL $8526    ;
 $8509 RET           ;

; Routine at 850A
;
; Get FAT cluster address for a directory entry. Reads the 2-byte start-cluster
; field at offset +$0C in the 18-byte entry. If zero, returns Fc=1. Otherwise
; returns HL = $E000 + cluster with Fc=0.
;
;        HL Pointer to directory entry (base of 18-byte structure)
; Output: HL FAT sector address ($E000 + cluster), Fc=1 if cluster is zero
@label=get_cluster_addr
c$850A LD D,H        ;
 $850B LD E,L        ;
 $850C LD BC,$000C   ;
 $850F ADD HL,BC     ;
 $8510 LD C,(HL)     ;
 $8511 INC HL        ;
 $8512 LD B,(HL)     ;
 $8513 LD A,B        ;
 $8514 OR C          ;
 $8515 JR Z,$851D    ;
 $8517 LD HL,$E000   ;
 $851A ADD HL,BC     ;
 $851B AND A         ;
 $851C RET           ;

; Routine at 851D
;
; Return with carry set and HL pointing to the entry. Tail of L850A when
; cluster field is zero.
c$851D EX DE,HL      ;
 $851E INC HL        ;
 $851F SCF           ;
 $8520 RET           ;

; Routine at 8521
;
; Add FAT base address $E000 to HL.
;
;        HL Cluster number
; Output: HL FAT sector address ($E000 + cluster)
c$8521 LD DE,$E000   ;
 $8524 ADD HL,DE     ;
 $8525 RET           ;

; Routine at 8526
;
; Copy and format a DOS 8.3 filename from a directory entry into the display
; buffer at DE ($BBF3). Reads up to 8 printable characters from HL, stops at
; NUL or non-printable. Tracks character count in C.
;
; HL Source: pointer to 8.3 filename in directory entry
; DE Destination buffer ($BBF3 on entry)
; C Character count (0 on entry)
@label=fmt_dosname
c$8526 LD DE,$BBF3   ;
 $8529 LD C,$00      ;
; This entry point is used by the routine at #R$853F.
*$852B LD A,C        ;
 $852C CP $0B        ;
 $852E JR NC,$8549   ;
 $8530 LD A,(HL)     ;
 $8531 AND A         ;
 $8532 JR Z,$8549    ;
 $8534 CP $21        ;
 $8536 JR C,$8545    ;
 $8538 LD B,A        ;
 $8539 LD A,C        ;
 $853A CP $08        ;
 $853C JR NZ,$8542   ;

; Data block at 853E
;
; Self-modify byte: replaced at runtime with the opcode for LD L,$12 used in
; L853F to indicate the name overflows into an extension component.
b$853E DEFB $3E

; Routine at 853F
;
; Continuation of filename copy. Stores character B at (DE), advances DE.
c$853F LD L,$12      ;
 $8541 INC DE        ;
; This entry point is used by the routine at #R$8526.
*$8542 LD A,B        ;
 $8543 LD (DE),A     ;
 $8544 INC DE        ;
; This entry point is used by the routine at #R$8526.
*$8545 INC HL        ;
 $8546 INC C         ;
 $8547 JR $852B      ;

; Routine at 8549
;
; Null-terminate the display name: writes $00 to (DE).
c$8549 XOR A         ;
 $854A LD (DE),A     ;
 $854B RET           ;

; Routine at 854C
;
; Trim path display. Checks LA3D1 bit 2 (dir-cache flag); if set, scans the
; directory list at $BC00 counting NUL-terminated entries and clears $BF6D /
; $BF70.
c$854C LD A,($A3E5)  ;
 $854F AND $04       ;
 $8551 RET Z         ;
 $8552 LD HL,$BC00   ;
 $8555 LD BC,$0000   ;
*$8558 LD A,(HL)     ;
 $8559 AND A         ;
 $855A JR Z,$8560    ;
 $855C INC HL        ;
 $855D INC C         ;
 $855E JR $8558      ;

; Routine at 8560
;
; Find the last '/' path separator in the path buffer $BC00. Scans backward
; from position C; if none found, returns without updating $BF70.
c$8560 XOR A         ;
 $8561 LD ($BF6D),A  ;
 $8564 LD ($BF70),A  ;
 $8567 LD A,C        ;
 $8568 CP $01        ;
 $856A RET Z         ;
 $856B RET C         ;
 $856C DEC C         ;
 $856D LD HL,$BC00   ;
 $8570 ADD HL,BC     ;
 $8571 LD (HL),$00   ;
 $8573 DEC HL        ;
 $8574 LD B,C        ;
*$8575 LD A,(HL)     ;
 $8576 CP $2F        ;
 $8578 JR Z,$857E    ;
 $857A DEC HL        ;
 $857B DJNZ $8575    ;
 $857D RET           ;

; Routine at 857E
;
; Copy the last path component (after the final '/') to $BF70 using LA0E0
; append-copy.
c$857E INC HL        ;
 $857F LD DE,$BF70   ;
 $8582 CALL $A0F4    ;
 $8585 LD A,C        ;
 $8586 LD ($BF6D),A  ;
 $8589 RET           ;

; Message at 858A
;
; Status message "Working..." shown during long directory loads.
t$858A DEFM "Working..."

; Data block at 8594
;
; Directory-load progress flag byte.
b$8594 DEFB $00

; Routine at 8595
;
; Load or refresh the directory listing. A is a flag byte: bit 2 ($04) = reset
; scroll positions; bit 1 ($02) = update display; bit 3 ($08) = suppress
; "Working..." message; bit 4 ($10) = suppress display. Calls L94AC to try the
; cache, then navigates to the stored path and builds the entry list.
;
; A Flags: $04=reset scroll, $02=update display, $08=quiet, $10=no display
@label=load_dir
c$8595 LD E,A        ;
 $8596 LD L,$01      ;
 $8598 CALL $A198    ;
 $859B LD A,E        ;
 $859C AND $04       ;
 $859E JR Z,$85AC    ;
 $85A0 LD HL,$0000   ;
 $85A3 LD ($BBEB),HL ;
 $85A6 LD ($BBED),HL ;
 $85A9 LD ($BBEF),HL ;
*$85AC PUSH DE       ;
 $85AD CALL $94BB    ;
 $85B0 POP DE        ;
 $85B1 LD A,L        ;
 $85B2 AND A         ;
 $85B3 JR Z,$85BC    ;
 $85B5 LD A,E        ;
 $85B6 OR $10        ;
 $85B8 LD E,A        ;
 $85B9 PUSH DE       ;
 $85BA JR $85F6      ;

; Routine at 85BC
;
; Display-side continuation of L8595. Shows "Working..." if needed, loads via
; L9105, then triggers rendering.
c$85BC PUSH DE       ;
 $85BD LD A,E        ;
 $85BE AND $02       ;
 $85C0 JR Z,$85F6    ;
 $85C2 LD A,E        ;
 $85C3 AND $08       ;
 $85C5 JR NZ,$85CD   ;
 $85C7 LD HL,$858A   ;
 $85CA CALL $8CB8    ;
*$85CD CALL $9114    ;
 $85D0 LD DE,($BBE9) ;
 $85D4 LD BC,$C200   ;
 $85D7 LD HL,($BF66) ;
 $85DA LD A,H        ;
 $85DB OR L          ;
 $85DC LD HL,($BF68) ;
 $85DF OR H          ;
 $85E0 OR L          ;
 $85E1 AND A         ;
 $85E2 JR Z,$85EB    ;
 $85E4 DEC DE        ;
 $85E5 LD HL,$0012   ;
 $85E8 ADD HL,BC     ;
 $85E9 LD B,H        ;
 $85EA LD C,L        ;
*$85EB EX DE,HL      ;
 $85EC LD DE,$0012   ;
 $85EF LD IX,$8964   ;
 $85F3 CALL $8877    ;
; This entry point is used by the routine at #R$8595.
*$85F6 LD A,$2A      ;
 $85F8 LD HL,$BC00   ;
 $85FB RST $08       ;
 $85FC DEFB $A8      ;
 $85FD POP DE        ;
 $85FE LD A,E        ;
 $85FF LD ($8667),A  ;
 $8602 AND $01       ;
 $8604 JR Z,$8678    ;
 $8606 LD A,E        ;
 $8607 AND $08       ;
 $8609 JR NZ,$864C   ;
 $860B LD A,($BF6D)  ;
 $860E AND A         ;
 $860F JR Z,$864C    ;
 $8611 LD BC,($BBE9) ;
 $8615 LD HL,$C200   ;
; This entry point is used by the routine at #R$8642.
*$8618 PUSH BC       ;
 $8619 LD A,(HL)     ;
 $861A AND $01       ;
 $861C JR Z,$8642    ;
 $861E LD DE,$BF70   ;
 $8621 LD A,($BF6D)  ;
 $8624 LD B,A        ;
 $8625 LD ($8640),HL ;
 $8628 INC HL        ;
*$8629 LD A,(HL)     ;
 $862A LD C,A        ;
 $862B LD A,(DE)     ;
 $862C CP C          ;
 $862D JR NZ,$863F   ;
 $862F INC HL        ;
 $8630 INC DE        ;
 $8631 DJNZ $8629    ;
 $8633 POP BC        ;
 $8634 LD HL,($BBE9) ;
 $8637 OR A          ;
 $8638 SBC HL,BC     ;
 $863A LD ($BBEF),HL ;
 $863D JR $864C      ;

; Data block at 863F
;
; Self-modify byte: replaced at runtime with an opcode used by the L8642
; entry-scan loop.
b$863F DEFB $21

; Data block at 8640
;
; Self-modifying pointer: current directory entry pointer used by the L85BC
; scan loop.
b$8640 DEFB $00,$00

; Routine at 8642
;
; Advance to the next entry in the directory scan started at L85BC. Increments
; the entry pointer by 18 bytes and decrements the remaining count; loops back
; while more entries remain.
c$8642 LD BC,$0012   ;
 $8645 ADD HL,BC     ;
 $8646 POP BC        ;
 $8647 DEC BC        ;
 $8648 LD A,B        ;
 $8649 OR C          ;
 $864A JR NZ,$8618   ;
; This entry point is used by the routine at #R$85BC.
*$864C LD HL,($BBEF) ;
 $864F LD A,H        ;
 $8650 OR L          ;
 $8651 AND A         ;
 $8652 JR Z,$8660    ;
 $8654 CALL $892F    ;
 $8657 AND A         ;
 $8658 JR NZ,$8660   ;
 $865A LD HL,($BBEF) ;
 $865D LD ($BBEB),HL ;
*$8660 LD HL,$BC00   ;
 $8663 CALL $8CB8    ;

; Data block at 8666
;
; Self-modify byte: replaced at runtime with LD A,n opcode.
b$8666 DEFB $3E

; Data block at 8667
;
; Display flags byte written by L85BC. Bit 0=directory entered, bit 1=update
; display, bit 3=quiet, bit 4=preview update.
b$8667 DEFB $00

; Routine at 8668
;
; Handle preview-panel update. If bit 4 of L8667 is set, draws the 31-character
; preview bar (L867E). Then calls L89F4 to refresh the status display.
c$8668 AND $10       ;
 $866A JR Z,$8675    ;
 $866C LD BC,$001F   ;
 $866F LD HL,$867E   ;
 $8672 CALL $97C3    ;
*$8675 CALL $89F4    ;
; This entry point is used by the routine at #R$85BC.
*$8678 XOR A         ;
 $8679 LD L,A        ;
 $867A CALL $A198    ;
 $867D RET           ;

; Data block at 867E
;
; Self-modifying two-byte parameter for the preview-bar draw call at L8668.
b$867E DEFB $2A,$00

; Routine at 8680
;
; Navigate to a path component inside the cached directory list at $BC00. DE
; points to the next path segment (NUL-terminated). Scans all 18-byte entries
; in HL looking for a case-insensitive name match. On match, copies
; size/cluster fields to $BF66 and calls L9105. Advances DE past the next '/'
; on each recursive entry.
;
; HL Pointer to start of directory list ($BC00)
; DE Pointer to path component string (NUL-terminated)
@label=nav_path
c$8680 INC HL        ;
 $8681 LD ($BFAA),HL ;
 $8684 EX DE,HL      ;
 $8685 LD A,$01      ;
 $8687 LD ($BF89),A  ;
 $868A LD L,A        ;
 $868B CALL $A198    ;
; This entry point is used by the routine at #R$8702.
*$868E LD A,(DE)     ;
 $868F AND A         ;
 $8690 JP Z,$870F    ;
 $8693 CP $2F        ;
 $8695 JR NZ,$870B   ;
 $8697 XOR A         ;
 $8698 LD (DE),A     ;
 $8699 LD BC,($BBE9) ;
 $869D LD HL,$C200   ;
; This entry point is used by the routine at #R$86F4.
*$86A0 PUSH BC       ;
 $86A1 LD A,(HL)     ;
 $86A2 AND $01       ;
 $86A4 JR Z,$86F5    ;
 $86A6 PUSH HL       ;
 $86A7 LD ($8700),DE ;
 $86AB INC HL        ;
 $86AC CALL $8526    ;
 $86AF LD DE,($BFAA) ;
 $86B3 LD HL,$BBF3   ;
*$86B6 LD A,(HL)     ;
 $86B7 CP $41        ;
 $86B9 JR C,$86C1    ;
 $86BB CP $5B        ;
 $86BD JR NC,$86C1   ;
 $86BF OR $20        ;
*$86C1 LD C,A        ;
 $86C2 LD A,(DE)     ;
 $86C3 CP $41        ;
 $86C5 JR C,$86CD    ;
 $86C7 CP $5B        ;
 $86C9 JR NC,$86CD   ;
 $86CB OR $20        ;
*$86CD CP C          ;
 $86CE JR NZ,$86F4   ;
 $86D0 INC DE        ;
 $86D1 INC HL        ;
 $86D2 OR A          ;
 $86D3 JR NZ,$86B6   ;
 $86D5 LD A,(DE)     ;
 $86D6 DEC DE        ;
 $86D7 LD ($8700),DE ;
 $86DB POP HL        ;
 $86DC POP BC        ;
 $86DD LD BC,$000E   ;
 $86E0 ADD HL,BC     ;
 $86E1 LD DE,$BF66   ;
 $86E4 LDI           ;
 $86E6 LDI           ;
 $86E8 LDI           ;
 $86EA LDI           ;
 $86EC AND A         ;
 $86ED JR Z,$86FF    ;
 $86EF CALL $9114    ;
 $86F2 JR $86FF      ;

; Routine at 86F4
;
; Skip to next entry in the L8680 navigation scan. Advances HL by 18 bytes,
; decrements entry count BC; loops back to L8680_1 if more remain.
c$86F4 POP HL        ;
; This entry point is used by the routine at #R$8680.
*$86F5 LD BC,$0012   ;
 $86F8 ADD HL,BC     ;
 $86F9 POP BC        ;
 $86FA DEC BC        ;
 $86FB LD A,B        ;
 $86FC OR C          ;
 $86FD JR NZ,$86A0   ;

; Data block at 86FF
;
; Self-modify byte: replaced at runtime with LD DE,n opcode.
b$86FF DEFB $11

; Data block at 8700
;
; Self-modifying pointer: current path pointer used by L8680 scan.
b$8700 DEFB $00,$00

; Routine at 8702
;
; Append '/' to the path string at DE, then copy the pointer to $BFAA and
; advance DE into the next path component.
c$8702 LD A,$2F      ;
 $8704 LD (DE),A     ;
 $8705 LD H,D        ;
 $8706 LD L,E        ;
 $8707 INC HL        ;
 $8708 LD ($BFAA),HL ;
; This entry point is used by the routine at #R$8680.
*$870B INC DE        ;
 $870C JP $868E      ;

; Routine at 870F
;
; Clear path-navigation state flag ($BF89 = 0) and return. Called when the DE
; path string reaches its NUL terminator.
c$870F XOR A         ;
 $8710 LD ($BF89),A  ;
 $8713 LD L,A        ;
 $8714 CALL $A198    ;
 $8717 RET           ;

; Message at 8718
;
; Path string "/bin/browse" — used when loading the browse config file.
t$8718 DEFM "/bin/browse"

; Message at 8723
;
; Extension string ".cfg" — config file extension suffix.
t$8723 DEFM ".cfg"

; Data block at 8727
;
; NUL terminator byte following L8723.
b$8727 DEFB $00

; Message at 8728
;
; Path prefix "/bin/brows" — used for plugin path building.
t$8728 DEFM "/bin/brows"

; Routine at 8732
;
; Load browse configuration. Opens "/bin/browse.cfg" from the system drive '$',
; reads settings into $A3CA. Then loads the current-directory list from
; "/bin/brows" with offset $0308 into $9867.
@label=load_config
c$8732 LD H,L        ;
 $8733 LD L,$66      ;
 $8735 LD L,(HL)     ;
 $8736 LD (HL),H     ;
 $8737 NOP           ;
; This entry point is used by the routine at #R$9DEA.
*$8738 LD HL,$8718   ;
 $873B LD BC,$0000   ;
 $873E LD DE,$A3DE   ;
 $8741 CALL $93DA    ;
 $8744 LD HL,$8728   ;
 $8747 LD BC,$0308   ;
 $874A LD DE,$9876   ;
 $874D CALL $93DA    ;
 $8750 CALL $982E    ;
 $8753 RET           ;

; Routine at 8754
;
; Initialize the browser and perform a full display refresh. Clears file
; cluster fields ($BF66/$BF68), calls L8595 with flags=$02 (update display),
; navigates the directory list from $BC00, and returns.
@label=browser_init
c$8754 LD HL,$0000   ;
 $8757 LD ($BF66),HL ;
 $875A LD ($BF68),HL ;
 $875D LD A,$02      ;
 $875F CALL $8595    ;
 $8762 LD HL,$BC00   ;
 $8765 CALL $8680    ;
 $8768 RET           ;

; Routine at 8769
;
; Find the file extension pointer in the current filename ($BBF3). Scans for
; the last '.' character; saves its address in DE.
;
;        HL Pointer to start of filename ($BBF3)
; Output: DE Pointer to '.' separator, or zero if no extension found
c$8769 LD HL,$BBF3   ;
 $876C LD DE,$0000   ;
*$876F LD A,(HL)     ;
 $8770 OR A          ;
 $8771 JR Z,$877C    ;
 $8773 CP $2E        ;
 $8775 JR NZ,$8779   ;
 $8777 LD D,H        ;
 $8778 LD E,L        ;
*$8779 INC HL        ;
 $877A JR $876F      ;

; Routine at 877C
;
; Handle file extension. Copies the 4-byte extension from DE to $BF7D, resets
; handler pointers at LA365/LA37C, then dispatches to the appropriate plugin
; via LA357 and LA20E.
c$877C LD A,D        ;
 $877D OR E          ;
 $877E RET Z         ;
 $877F EX DE,HL      ;
 $8780 LD DE,$BF7D   ;
 $8783 LD BC,$0004   ;
 $8786 PUSH HL       ;
 $8787 LDIR          ;
 $8789 POP HL        ;
 $878A XOR A         ;
 $878B LD ($A379),A  ;
 $878E LD ($A390),A  ;
 $8791 LD DE,$A36B   ;
 $8794 INC HL        ;
 $8795 PUSH HL       ;
 $8796 CALL $A0F4    ;
 $8799 POP HL        ;
 $879A CALL $A222    ;
 $879D LD HL,$0000   ;
 $87A0 LD ($BF82),HL ;
; This entry point is used by the routines at #R$8808 and #R$8830.
*$87A3 LD HL,$A36B   ;
 $87A6 CALL $A23E    ;
 $87A9 LD A,($A3C3)  ;
 $87AC LD B,A        ;
 $87AD AND $08       ;
 $87AF JP Z,$883B    ;
 $87B2 LD A,B        ;
 $87B3 AND $02       ;
 $87B5 JR Z,$87BC    ;
 $87B7 LD A,$01      ;
 $87B9 LD ($A3C6),A  ;
; This entry point is used by the routine at #R$8808.
*$87BC LD A,($A3C4)  ;
 $87BF CP $03        ;
 $87C1 JR NZ,$87D0   ;
 $87C3 LD HL,$0000   ;
 $87C6 LD ($BBEF),HL ;
 $87C9 LD A,$01      ;
 $87CB LD ($A3C4),A  ;
 $87CE JR $87DF      ;

; Routine at 87D0
;
; Adjust initial cursor position based on plugin-mode byte at LA3B0. Mode $03
; resets $BBEF to 0; mode $04 moves to the last entry; mode $01 advances $BBEF
; by one (wrapping at total count).
c$87D0 CP $04        ;
 $87D2 JR NZ,$87DF   ;
 $87D4 LD HL,($BBE9) ;
 $87D7 LD ($BBEF),HL ;
 $87DA LD A,$02      ;
 $87DC LD ($A3C4),A  ;
; This entry point is used by the routine at #R$877C.
*$87DF CP $01        ;
 $87E1 JR NZ,$87FB   ;
 $87E3 LD HL,($BBEF) ;
 $87E6 LD D,H        ;
 $87E7 LD E,L        ;
 $87E8 INC HL        ;
 $87E9 LD ($BBEF),HL ;
 $87EC LD BC,($BBE9) ;
 $87F0 OR A          ;
 $87F1 SBC HL,BC     ;
 $87F3 JR NZ,$8808   ;
 $87F5 EX DE,HL      ;
 $87F6 LD ($BBEF),HL ;
 $87F9 JR $883B      ;

; Routine at 87FB
;
; Move cursor backward one entry. Decrements $BBEF; if it reaches zero, jumps
; to L883B (plugin boundary check).
c$87FB LD HL,($BBEF) ;
 $87FE DEC HL        ;
 $87FF LD ($BBEF),HL ;
 $8802 LD A,H        ;
 $8803 OR L          ;
 $8804 JR NZ,$8808   ;
 $8806 JR $883B      ;

; Routine at 8808
;
; After cursor move, check if the new entry matches the search filter at $BF7D.
; Re-renders if not at a matching entry; adjusts view via L8A94_0 otherwise.
c$8808 CALL $84FF    ;
 $880B LD DE,$BBF3   ;
 $880E LD HL,$BF7D   ;
 $8811 CALL $A107    ;
 $8814 JR C,$87BC    ;
 $8816 LD A,($A3C6)  ;
 $8819 OR A          ;
 $881A JR NZ,$87A3   ;
 $881C LD HL,($BBEF) ;
 $881F CALL $892F    ;
 $8822 AND A         ;
 $8823 JR NZ,$8830   ;
 $8825 LD HL,($BBEF) ;
 $8828 LD ($BBEB),HL ;
 $882B CALL $89F4    ;
 $882E JR $8835      ;

; Routine at 8830
;
; Force scroll to keep cursor visible (calls L8A94_0 with $80), then re-reads
; the current entry filename via L84FF.
c$8830 LD A,$80      ;
 $8832 CALL $8A96    ;
; This entry point is used by the routine at #R$8808.
*$8835 CALL $84FF    ;
 $8838 JP $87A3      ;

; Routine at 883B
;
; Handle plugin boundary / cursor at position $BF82. Computes visible-window
; bounds for a 22-entry page and updates $BBEB/$BBED/$BBEF. On return, calls
; LA344 if LA3B2 (needs-reload flag) is set.
c$883B CALL $A233    ;
 $883E LD HL,($BF82) ;
 $8841 LD A,H        ;
 $8842 OR L          ;
 $8843 JR Z,$886E    ;
 $8845 PUSH HL       ;
 $8846 CALL $892F    ;
 $8849 POP HL        ;
 $884A AND A         ;
 $884B JR NZ,$886B   ;
 $884D EX DE,HL      ;
 $884E LD HL,$BBE9   ;
 $8851 LD BC,$0016   ;
 $8854 OR A          ;
 $8855 SBC HL,BC     ;
 $8857 EX DE,HL      ;
 $8858 JR C,$8861    ;
 $885A LD DE,$0015   ;
 $885D SBC HL,DE     ;
 $885F JR $8868      ;

; Routine at 8861
;
; Set first-visible index $BBEB = 0 and last-visible $BBED = computed page end.
c$8861 LD DE,$0000   ;
 $8864 LD ($BBEB),DE ;
; This entry point is used by the routine at #R$883B.
*$8868 LD ($BBED),HL ;
; This entry point is used by the routine at #R$883B.
*$886B LD ($BBEF),HL ;
; This entry point is used by the routine at #R$883B.
*$886E LD A,($A3C6)  ;
 $8871 OR A          ;
 $8872 RET Z         ;
 $8873 CALL $A358    ;
 $8876 RET           ;

; Routine at 8877
;
; Render the full directory listing. Takes IX=entry-render callback, DE=first
; entry address, HL=first entry index, BC=page size. Calls L8909 to compute the
; starting screen position, then iterates rendering up to 22 entries.
;
; IX Pointer to per-entry render routine (e.g. L8964)
; DE Pointer to first visible entry in buffer
; HL First visible entry index
; BC Number of entries to render
@label=render_dir_list
c$8877 LD ($88DA),IX ;
 $887B EX DE,HL      ;
 $887C PUSH DE       ;
 $887D PUSH HL       ;
 $887E LD ($8905),BC ;
 $8882 CALL $8909    ;
 $8885 LD ($88FF),HL ;
; This entry point is used by the routine at #R$88AC.
*$8888 POP DE        ;
 $8889 POP HL        ;
 $888A SRL H         ;
 $888C RR L          ;
 $888E LD A,H        ;
 $888F OR L          ;
 $8890 RET Z         ;
 $8891 PUSH HL       ;
 $8892 PUSH DE       ;
 $8893 CALL $8909    ;
 $8896 LD ($8907),HL ;
 $8899 POP DE        ;
 $889A PUSH DE       ;
 $889B PUSH HL       ;
 $889C ADD HL,DE     ;
 $889D LD ($8901),HL ;
 $88A0 LD DE,($8905) ;
 $88A4 EX (SP),HL    ;
 $88A5 ADD HL,DE     ;
 $88A6 LD ($8903),HL ;
 $88A9 POP HL        ;
 $88AA JR $88B3      ;

; Routine at 88AC
;
; Render loop body: draws one entry row using the IX callback, then advances
; pointers and loops back.
c$88AC LD DE,($88FB) ;
 $88B0 POP HL        ;
 $88B1 PUSH HL       ;
 $88B2 ADD HL,DE     ;
; This entry point is used by the routine at #R$8877.
*$88B3 LD ($88FB),HL ;
 $88B6 EX DE,HL      ;
 $88B7 LD HL,($88FF) ;
 $88BA SBC HL,DE     ;
 $88BC JR C,$8888    ;
 $88BE LD HL,($8901) ;
 $88C1 EX DE,HL      ;
; This entry point is used by the routine at #R$88DC.
*$88C2 AND A         ;
 $88C3 SBC HL,DE     ;
 $88C5 LD ($88FD),HL ;
 $88C8 JP M,$88AC    ;
 $88CB LD C,L        ;
 $88CC LD B,H        ;
 $88CD LD HL,($8903) ;
 $88D0 ADD HL,BC     ;
 $88D1 EX DE,HL      ;
 $88D2 LD HL,($8905) ;
 $88D5 ADD HL,BC     ;
 $88D6 PUSH HL       ;
 $88D7 PUSH BC       ;
 $88D8 PUSH DE       ;

; Data block at 88D9
;
; Self-modify byte ($CD = CALL opcode) for the self-modifying CALL in L88AC.
b$88D9 DEFB $CD

; Data block at 88DA
;
; Self-modifying call target address used by L88AC render loop.
b$88DA DEFB $00,$00

; Routine at 88DC
;
; Continuation of directory-list render: copies pixel row from source to
; destination, moves to next entry, loops back via L88AC.
c$88DC LD A,H        ;
 $88DD OR A          ;
 $88DE LD A,L        ;
 $88DF POP DE        ;
 $88E0 POP BC        ;
 $88E1 POP HL        ;
 $88E2 JP P,$88AC    ;
 $88E5 POP BC        ;
 $88E6 PUSH BC       ;
 $88E7 PUSH HL       ;
*$88E8 LD A,(DE)     ;
 $88E9 LDI           ;
 $88EB DEC HL        ;
 $88EC LD (HL),A     ;
 $88ED INC HL        ;
 $88EE JP PE,$88E8   ;
 $88F1 POP HL        ;
 $88F2 LD HL,($88FD) ;
 $88F5 LD DE,($8907) ;
 $88F9 JR $88C2      ;

; Unused
s$88FB DEFS $02

; Data block at 88FD
;
; Saved first visible entry address (used by L88AC render loop).
b$88FD DEFB $00,$00

; Data block at 88FF
;
; Saved first visible entry index (used by L88AC render loop).
b$88FF DEFB $00,$00

; Data block at 8901
;
; Scratch pointer 1 used by L8877 render loop.
b$8901 DEFB $00,$00

; Data block at 8903
;
; Scratch pointer 2 used by L8877 render loop.
b$8903 DEFB $00,$00

; Data block at 8905
;
; Saved page size (BC on entry to L8877).
b$8905 DEFB $00,$00

; Data block at 8907
;
; Saved pointer used by L88DC scroll copy.
b$8907 DEFB $00,$00

; Routine at 8909
;
; Compute a scaled screen address offset from two packed values.
; Multiplies/shifts parameters into a screen row offset for use in the render
; loop.
c$8909 INC H         ;
 $890A DEC H         ;
 $890B JR Z,$8918    ;
 $890D INC D         ;
 $890E DEC D         ;
 $890F JR Z,$8917    ;
 $8911 LD C,L        ;
 $8912 LD A,H        ;
 $8913 LD B,$10      ;
 $8915 JR $891B      ;

; Routine at 8917
;
; Shift-and-add multiplication helper. Computes HL = (A * 16 + C) or variants
; via bit accumulation.
c$8917 EX DE,HL      ;
; This entry point is used by the routine at #R$8909.
*$8918 LD A,L        ;
 $8919 LD B,$08      ;
; This entry point is used by the routine at #R$8909.
*$891B LD HL,$0000   ;
*$891E ADD HL,HL     ;
 $891F RL C          ;
 $8921 RLA           ;
 $8922 JR NC,$8925   ;
 $8924 ADD HL,DE     ;
*$8925 DJNZ $891E    ;
 $8927 OR A          ;
 $8928 RET           ;

; Message at 8929
;
; Directory-entry marker string "<DIR" appended to entries that are
; subdirectories.
t$8929 DEFM "<DIR"

; Routine at 892D
;
; Check if entry index DE is within the visible window [$BBEB..$BBED]. Returns
; A=1 if visible, A=0 if outside.
;
;        HL Entry index to test (also accepts call via L892D_0 with DE)
; Output: A 1 if entry is in visible window, 0 if not
@label=in_visible_range
c$892D LD A,$00      ;
; This entry point is used by the routines at #R$8642, #R$8808, #R$883B,
; #R$8AA5, #R$8AC8, #R$8B0D, #R$8B3A and #R$8BA2.
*$892F EX DE,HL      ;
 $8930 OR A          ;
 $8931 LD HL,($BBEB) ;
 $8934 SBC HL,DE     ;
 $8936 JR Z,$8942    ;
 $8938 JR NC,$8945   ;
 $893A OR A          ;
 $893B LD HL,($BBED) ;
 $893E SBC HL,DE     ;
 $8940 JR C,$8945    ;
*$8942 LD A,$01      ;
 $8944 RET           ;

; Routine at 8945
;
; Return A=0 (not in visible range). Tail of L892D.
c$8945 XOR A         ;
 $8946 RET           ;

; Routine at 8947
;
; Clear the full browser screen area. Clears all 22 character rows (rows 1–22)
; by calling L978F for each. Then fills the attribute row at $5820 with the
; LA3CD background colour.
@label=clear_screen
c$8947 LD B,$16      ;
 $8949 LD C,$01      ;
*$894B PUSH BC       ;
 $894C LD B,C        ;
 $894D CALL $979E    ;
 $8950 POP BC        ;
 $8951 INC C         ;
 $8952 DJNZ $894B    ;
 $8954 LD A,($A3E1)  ;
 $8957 LD HL,$5820   ;
 $895A LD (HL),A     ;
 $895B LD DE,$5821   ;
 $895E LD BC,$02BF   ;
 $8961 LDIR          ;
 $8963 RET           ;

; Routine at 8964
;
; Compare two directory entries for ordering/matching. Reads start-cluster from
; both entries via L850A; compares 8.3 filenames case-insensitively byte by
; byte. Returns HL=0 if equal, HL=$0001 if entry 1 < entry 2, HL=$FFFF if entry
; 1 > entry 2.
;
;        HL Pointer to first directory entry
;        DE Pointer to second directory entry
; Output: HL 0=equal, $0001=less-than, $FFFF=greater-than
c$8964 LD A,(HL)     ;
 $8965 LD B,A        ;
 $8966 LD A,(DE)     ;
 $8967 CP B          ;
 $8968 JR NZ,$899B   ;
 $896A EX DE,HL      ;
 $896B PUSH DE       ;
 $896C CALL $850A    ;
 $896F EX DE,HL      ;
 $8970 POP HL        ;
 $8971 PUSH DE       ;
 $8972 CALL $850A    ;
 $8975 POP DE        ;
*$8976 LD A,(HL)     ;
 $8977 CP $41        ;
 $8979 JR C,$8981    ;
 $897B CP $5B        ;
 $897D JR NC,$8981   ;
 $897F OR $20        ;
*$8981 LD C,A        ;
 $8982 LD A,(DE)     ;
 $8983 CP $41        ;
 $8985 JR C,$898D    ;
 $8987 CP $5B        ;
 $8989 JR NC,$898D   ;
 $898B OR $20        ;
*$898D CP C          ;
 $898E JR NZ,$8998   ;
 $8990 INC DE        ;
 $8991 INC HL        ;
 $8992 OR A          ;
 $8993 JR NZ,$8976   ;
 $8995 LD L,A        ;
 $8996 LD H,A        ;
 $8997 RET           ;

; Routine at 8998
;
; Return H = (A minus C) as comparison result.
c$8998 SUB C         ;
 $8999 LD H,A        ;
 $899A RET           ;

; Routine at 899B
;
; Return HL=$FFFF (less-than result for entry type mismatch: dir vs file).
c$899B AND $01       ;
 $899D JR Z,$89A3    ;
 $899F LD HL,$FFFF   ;
 $89A2 RET           ;

; Routine at 89A3
;
; Return HL=$0001 (greater-than result for entry type mismatch).
c$89A3 LD HL,$0001   ;
 $89A6 RET           ;

; Routine at 89A7
;
; Select and write the display attribute for screen row B. Bit 7 of C =
; selected/cursor row (uses LA3CF colour); bit 0 = directory (uses LA3CE
; colour); else normal colour from LA3CD. Calls L9726 to fill the 32-column
; attribute row.
;
; B Screen row number (1–22)
; C Attribute flags: bit 7 = cursor/selected, bit 0 = is directory
@label=draw_row_attr
c$89A7 LD A,C        ;
 $89A8 AND $80       ;
 $89AA JR Z,$89B1    ;
 $89AC LD A,($A3E3)  ;
 $89AF JR $89BE      ;

; Routine at 89B1
;
; Select attribute for a non-cursor row. Checks bit 0 for directory colour.
c$89B1 LD A,C        ;
 $89B2 AND $01       ;
 $89B4 JR Z,$89BB    ;
 $89B6 LD A,($A3E2)  ;
 $89B9 JR $89BE      ;

; Routine at 89BB
;
; Fill attribute row B with colour C via L9726.
c$89BB LD A,($A3E1)  ;
; This entry point is used by the routines at #R$89A7 and #R$89B1.
*$89BE LD C,A        ;
 $89BF CALL $9735    ;
 $89C2 RET           ;

; Routine at 89C3
;
; Render a single directory entry at screen row B. Loads the entry address from
; $BF62, gets the filename via L850A/L8526, draws the name using L97B4, then
; appends the "<DIR" marker if entry flag bit 0 is set and LA3D1 bit 0 is set.
;
; B Screen row number (1–22)
; C Attribute flags (bit 7=selected, bit 0=directory)
@label=render_entry
c$89C3 PUSH BC       ;
 $89C4 LD HL,($BF62) ;
 $89C7 CALL $850A    ;
 $89CA JR NC,$89D2   ;
 $89CC CALL $8526    ;
 $89CF LD HL,$BBF3   ;
*$89D2 POP BC        ;
 $89D3 PUSH BC       ;
 $89D4 LD C,$00      ;
 $89D6 CALL $97C3    ;
 $89D9 POP BC        ;
 $89DA LD A,C        ;
 $89DB AND $01       ;
 $89DD JR Z,$89F0    ;
 $89DF LD A,($A3E5)  ;
 $89E2 AND $01       ;
 $89E4 JR Z,$89F0    ;
 $89E6 PUSH BC       ;
 $89E7 LD HL,$8929   ;

; Data block at 89EA
;
; Self-modify byte: source screen-row offset for L89EC row copy.
b$89EA DEFB $0E

; Data block at 89EB
;
; Self-modify byte: destination row offset for L89EC row copy. Also holds the
; pixel width of the "<DIR" string (set by L981F).
b$89EB DEFB $1C

; Routine at 89EC
;
; Copy one character row on screen (scrolling optimisation). Calls L97B4 via
; L89A7 to update the attribute.
c$89EC CALL $97C3    ;
 $89EF POP BC        ;
; This entry point is used by the routine at #R$89C3.
*$89F0 CALL $89A7    ;
 $89F3 RET           ;

; Routine at 89F4
;
; Conditional display refresh. If $BBE6 (preview flag) is non-zero, calls L96D2
; (preview panel update); otherwise calls L89FE (full redraw).
@label=refresh_display
c$89F4 LD A,($BBE6)  ;
 $89F7 AND A         ;
 $89F8 JR Z,$89FE    ;
 $89FA CALL $96E1    ;
 $89FD RET           ;

; Routine at 89FE
;
; Full redraw of all visible directory entries. Iterates from $BBEB (first
; visible index) for up to 22 entries. For each: calls L89C3 to render,
; advances the entry pointer by 18 bytes, updates $BBED (last-visible index).
; Calls L9FB8 at the end to redraw the status bar.
@label=render_all_entries
c$89FE LD HL,($BF62) ;
 $8A01 PUSH HL       ;
 $8A02 LD A,$01      ;
 $8A04 LD ($8A7F),A  ;
 $8A07 LD A,($BBE4)  ;
 $8A0A AND A         ;
 $8A0B JR Z,$8A13    ;
 $8A0D LD C,$00      ;
 $8A0F LD B,A        ;
 $8A10 CALL $89A7    ;
*$8A13 CALL $8947    ;
 $8A16 OR A          ;
 $8A17 LD HL,($BBE9) ;
 $8A1A LD D,H        ;
 $8A1B LD E,L        ;
 $8A1C LD BC,($BBEF) ;
 $8A20 SBC HL,BC     ;
 $8A22 JR NZ,$8A29   ;
 $8A24 EX DE,HL      ;
 $8A25 DEC HL        ;
 $8A26 LD ($BBEF),HL ;
*$8A29 LD HL,($BBEB) ;
 $8A2C CALL $84EC    ;
 $8A2F LD BC,($BBEB) ;
*$8A33 EX DE,HL      ;
 $8A34 LD HL,($BBE9) ;
 $8A37 OR A          ;
 $8A38 SBC HL,BC     ;
 $8A3A JR Z,$8A77    ;
 $8A3C EX DE,HL      ;
 $8A3D LD A,($8A7F)  ;
 $8A40 LD D,A        ;
 $8A41 LD A,(HL)     ;
 $8A42 LD E,A        ;
 $8A43 PUSH HL       ;
 $8A44 PUSH BC       ;
 $8A45 LD HL,($BBEF) ;
 $8A48 OR A          ;
 $8A49 SBC HL,BC     ;
 $8A4B JR NZ,$8A57   ;
 $8A4D LD A,D        ;
 $8A4E LD ($BBE4),A  ;
 $8A51 LD A,E        ;
 $8A52 LD ($BBE8),A  ;
 $8A55 OR $80        ;
*$8A57 LD B,D        ;
 $8A58 LD C,A        ;
 $8A59 CALL $89C3    ;
 $8A5C POP BC        ;
 $8A5D POP HL        ;
 $8A5E LD ($BBED),BC ;
 $8A62 LD A,($8A7F)  ;
 $8A65 INC A         ;
 $8A66 CP $17        ;
 $8A68 JR Z,$8A77    ;
 $8A6A LD ($8A7F),A  ;
 $8A6D LD DE,$0012   ;
 $8A70 ADD HL,DE     ;
 $8A71 LD ($BF62),HL ;
 $8A74 INC BC        ;
 $8A75 JR $8A33      ;

; Routine at 8A77
;
; Restore $BF62 to the saved value from before the render loop, then call L9FB8
; (status bar update).
c$8A77 CALL $9FCC    ;
 $8A7A POP HL        ;
 $8A7B LD ($BF62),HL ;
 $8A7E RET           ;

; Unused
s$8A7F DEFS $01

; Routine at 8A80
;
; Move cursor to the first entry (Home). Passes command $03 to L8A94_0.
@label=nav_home
c$8A80 LD A,$03      ;
 $8A82 JR $8A96      ;

; Routine at 8A84
;
; Page up. Passes command $04 to L8A94_0.
@label=nav_pgup
c$8A84 LD A,$04      ;
 $8A86 JR $8A96      ;

; Routine at 8A88
;
; Move cursor up one entry. Passes command $01 to L8A94_0.
@label=nav_up
c$8A88 LD A,$01      ;
 $8A8A JR $8A96      ;

; Routine at 8A8C
;
; Move cursor down one entry. Passes command $02 to L8A94_0.
@label=nav_down
c$8A8C LD A,$02      ;
 $8A8E JR $8A96      ;

; Routine at 8A90
;
; Page down. Passes command $05 to L8A94_0.
@label=nav_pgdn
c$8A90 LD A,$05      ;
 $8A92 JR $8A96      ;

; Routine at 8A94
;
; Move cursor to the last entry (End). Passes command $06 to L8A94_0. Entry
; point L8A94_0 dispatches on A: $01=cursor up, $02=cursor down, $03=home,
; $04=end, $05=page up, $06=page down, $80=force-scroll to keep cursor visible.
@label=nav_end
c$8A94 LD A,$06      ;
; This entry point is used by the routines at #R$8830, #R$8A80, #R$8A84,
; #R$8A88, #R$8A8C and #R$8A90.
*$8A96 LD HL,($BBEF) ;
 $8A99 LD D,H        ;
 $8A9A LD E,L        ;
 $8A9B CP $80        ;
 $8A9D JR NZ,$8AA5   ;
 $8A9F INC HL        ;
 $8AA0 LD C,$00      ;
 $8AA2 JP $8C04      ;

; Routine at 8AA5
;
; Handle home command ($03). Checks if first entry is already visible; if so
; just updates $BBEF, otherwise resets $BBEB/$BBED to show from the top.
c$8AA5 CP $03        ;
 $8AA7 JR NZ,$8AC8   ;
 $8AA9 LD DE,$0000   ;
 $8AAC PUSH DE       ;
 $8AAD EX DE,HL      ;
 $8AAE CALL $892F    ;
 $8AB1 POP DE        ;
 $8AB2 AND A         ;
 $8AB3 JP NZ,$8BFF   ;
 $8AB6 LD HL,$0000   ;
 $8AB9 LD ($BBEB),HL ;
 $8ABC LD HL,$0016   ;
 $8ABF LD ($BBED),BC ;
 $8AC3 LD C,$FF      ;
 $8AC5 JP $8C01      ;

; Routine at 8AC8
;
; Handle end command ($04). Moves to the last entry (($BBE9)-1); adjusts
; $BBEB/$BBED so the last entry is visible.
c$8AC8 CP $04        ;
 $8ACA JR NZ,$8AF4   ;
 $8ACC LD DE,($BBE9) ;
 $8AD0 DEC DE        ;
; This entry point is used by the routine at #R$8AF4.
*$8AD1 PUSH DE       ;
 $8AD2 EX DE,HL      ;
 $8AD3 CALL $892F    ;
 $8AD6 POP DE        ;
 $8AD7 AND A         ;
 $8AD8 JP NZ,$8BFF   ;
 $8ADB LD H,D        ;
 $8ADC LD L,E        ;
 $8ADD LD BC,$0015   ;
 $8AE0 OR A          ;
 $8AE1 SBC HL,BC     ;
 $8AE3 JR NC,$8AE8   ;
 $8AE5 LD HL,$0000   ;
*$8AE8 LD ($BBEB),HL ;
 $8AEB LD ($BBED),DE ;
 $8AEF LD C,$FF      ;
 $8AF1 JP $8C01      ;

; Routine at 8AF4
;
; Handle page-down command ($06). Advances $BBEF by one page (22 entries),
; clamped to the last entry.
c$8AF4 CP $06        ;
 $8AF6 JR NZ,$8B0D   ;
 $8AF8 EX DE,HL      ;
 $8AF9 LD DE,$0016   ;
 $8AFC ADD HL,DE     ;
 $8AFD EX DE,HL      ;
 $8AFE LD HL,($BBE9) ;
 $8B01 DEC HL        ;
 $8B02 LD B,H        ;
 $8B03 LD C,L        ;
 $8B04 OR A          ;
 $8B05 SBC HL,DE     ;
 $8B07 JR NC,$8B0B   ;
 $8B09 LD D,B        ;
 $8B0A LD E,C        ;
*$8B0B JR $8AD1      ;

; Routine at 8B0D
;
; Handle page-up command ($05). Moves $BBEF back one page (22 entries), clamped
; to 0.
c$8B0D CP $05        ;
 $8B0F JR NZ,$8B3A   ;
 $8B11 EX DE,HL      ;
 $8B12 LD DE,$0016   ;
 $8B15 OR A          ;
 $8B16 SBC HL,DE     ;
 $8B18 EX DE,HL      ;
 $8B19 JR NC,$8B1E   ;
 $8B1B LD DE,$0000   ;
*$8B1E PUSH DE       ;
 $8B1F EX DE,HL      ;
 $8B20 CALL $892F    ;
 $8B23 POP DE        ;
 $8B24 AND A         ;
 $8B25 JP NZ,$8BFF   ;
 $8B28 LD ($BBEB),DE ;
 $8B2C LD H,D        ;
 $8B2D LD L,E        ;
 $8B2E LD BC,$0016   ;
 $8B31 ADD HL,BC     ;
 $8B32 LD ($BBED),HL ;
 $8B35 LD C,$FF      ;
 $8B37 JP $8C01      ;

; Routine at 8B3A
;
; Handle cursor-up command ($01). Decrements $BBEF; if the new entry would
; scroll off the top, decrements $BBEB and $BBED and scrolls the display up one
; row.
c$8B3A CP $01        ;
 $8B3C JR NZ,$8BA2   ;
 $8B3E LD A,D        ;
 $8B3F OR E          ;
 $8B40 JP Z,$8BFF    ;
 $8B43 DEC DE        ;
 $8B44 PUSH DE       ;
 $8B45 EX DE,HL      ;
 $8B46 CALL $892F    ;
 $8B49 POP DE        ;
 $8B4A AND A         ;
 $8B4B JP NZ,$8BFF   ;
 $8B4E LD BC,($BBEB) ;
 $8B52 DEC BC        ;
 $8B53 LD ($BBEB),BC ;
 $8B57 LD HL,($BBED) ;
 $8B5A PUSH HL       ;
 $8B5B OR A          ;
 $8B5C SBC HL,BC     ;
 $8B5E LD A,L        ;
 $8B5F POP HL        ;
 $8B60 CP $16        ;
 $8B62 JR C,$8B68    ;
 $8B64 DEC HL        ;
 $8B65 LD ($BBED),HL ;
*$8B68 LD A,($BBE6)  ;
 $8B6B AND A         ;
 $8B6C JP NZ,$8BFF   ;
 $8B6F PUSH DE       ;
 $8B70 LD B,$01      ;
 $8B72 LD A,($BBE8)  ;
 $8B75 LD C,A        ;
 $8B76 CALL $89A7    ;
 $8B79 XOR A         ;
 $8B7A LD ($BBE4),A  ;
 $8B7D LD B,$15      ;
 $8B7F LD C,$16      ;
*$8B81 PUSH BC       ;
 $8B82 LD A,B        ;
 $8B83 LD B,C        ;
 $8B84 LD C,A        ;
 $8B85 CALL $974D    ;
 $8B88 POP BC        ;
 $8B89 DEC C         ;
 $8B8A DJNZ $8B81    ;
 $8B8C LD B,$01      ;
 $8B8E CALL $979E    ;
 $8B91 POP DE        ;
 $8B92 LD H,D        ;
 $8B93 LD L,E        ;
 $8B94 CALL $84EC    ;
 $8B97 PUSH DE       ;
 $8B98 LD A,(HL)     ;
 $8B99 LD B,$01      ;
 $8B9B LD C,A        ;
